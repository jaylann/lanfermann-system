{
  "name": "@lanfermann/ui",
  "version": "0.14.0",
  "description": "Lanfermann design system components for Next.js + Tailwind CSS v4, built on Base UI.",
  "license": "MIT",
  "author": "Justin Lanfermann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaylann/lanfermann-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/jaylann/lanfermann-system#readme",
  "bugs": "https://github.com/jaylann/lanfermann-system/issues",
  "keywords": [
    "react",
    "nextjs",
    "tailwindcss",
    "base-ui",
    "design-system",
    "components"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "brand",
    "dist",
    "player",
    "src/styles.css",
    "src/styles/*.css",
    "src/slides/player/chrome.css",
    "TRADEMARK.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./slides": {
      "types": "./dist/slides/index.d.ts",
      "default": "./dist/slides/index.js"
    },
    "./slides/catalog": {
      "types": "./dist/slides/catalog/index.d.ts",
      "default": "./dist/slides/catalog/index.js"
    },
    "./slides/player": {
      "types": "./dist/slides/player/index.d.ts",
      "default": "./dist/slides/player/index.js"
    },
    "./slides/player/*": "./player/*",
    "./styles.css": "./src/styles.css",
    "./slides.css": "./src/styles/slides.css",
    "./slides/player.css": "./src/slides/player/chrome.css",
    "./brand/*": "./brand/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && node scripts/slides/build-player.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "storybook:phone": "node scripts/serve-static.ts",
    "visual:check": "node scripts/visual/docker.ts check",
    "visual:baseline": "node scripts/visual/docker.ts baseline",
    "gen:motion": "node scripts/generate-motion-css.ts",
    "gen:slides-catalog": "node scripts/generate-slides-catalog.ts",
    "brand:check": "node scripts/brand/check-copy.ts",
    "brand:grade": "node scripts/brand/grade-skill.ts",
    "shots": "node scripts/visual/capture.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-day-picker": "^10.0.2",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sofia-sans": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/oxide": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "motion": "^14.14.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
