{
  "name": "@lanfermann/slides",
  "version": "0.2.0",
  "description": "Starts, checks, previews, builds and packs a slide deck written with @lanfermann/ui/slides.",
  "license": "MIT",
  "author": "Justin Lanfermann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaylann/lanfermann-system.git",
    "directory": "packages/slides"
  },
  "homepage": "https://github.com/jaylann/lanfermann-system/tree/main/packages/slides#readme",
  "bugs": "https://github.com/jaylann/lanfermann-system/issues",
  "keywords": [
    "slides",
    "deck",
    "presentation",
    "cli",
    "react"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "slides": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.ts"
  },
  "dependencies": {
    "@lanfermann/ui": "workspace:*",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "playwright-core": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.1"
  }
}
